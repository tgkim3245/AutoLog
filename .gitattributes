# Normalize text files in Git while keeping Windows command scripts runnable.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets and distributables are never line-ending normalized.
*.7z binary
*.bmp binary
*.blf binary
*.dll binary
*.exe binary
*.ico binary
*.jpg binary
*.jpeg binary
*.msi binary
*.pcap binary
*.pcapng binary
*.png binary
*.zip binary
